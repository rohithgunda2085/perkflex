# Copy to .env (git-ignored) and fill in. Never commit real credentials.
DB_HOST=your-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# verify (default, uses backend/db/certs/global-bundle.pem) | no-verify | disable
DB_SSL=verify
# DB_SSL_CA=/path/to/custom-ca.pem
# DB_POOL_MAX=5

# Assistant (Amazon Bedrock). Create a key in Bedrock console > API keys.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Signs the login cookie. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Python API
# DEMO_MODE=true lets a signed-in user switch to another demo traveller. Turn it off for anything real.
DEMO_MODE=true
# Check-in windows are judged against this time (the seed flights are in 2026 and 2027). Leave empty to use the real clock.
DEMO_NOW=2027-12-15T23:59:00+00:00
# development | production (production marks the session cookie Secure)
ENVIRONMENT=development
