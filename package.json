{
  "name": "perkflex-local-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite frontend --host 0.0.0.0",
    "build": "npm run typecheck && vite build frontend",
    "preview": "vite preview frontend --host 0.0.0.0",
    "api": "cd backend && ../../.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 3001",
    "db:check": "cd backend && ../../.venv/bin/python -m app.cli check",
    "db:inspect": "cd backend && ../../.venv/bin/python -m app.cli inspect",
    "db:migrate": "cd backend && ../../.venv/bin/python -m app.cli migrate",
    "db:seed-users": "cd backend && ../../.venv/bin/python -m app.cli seed-users",
    "typecheck": "tsc -p frontend",
    "test": "npm run test:frontend && npm run test:py:offline",
    "test:frontend": "tsx --tsconfig frontend/tsconfig.json --test frontend/tests/ui.test.tsx",
    "test:ui": "npm run test:frontend",
    "test:py": "cd backend && ../../.venv/bin/python -m pytest -q",
    "test:py:offline": "cd backend && ../../.venv/bin/python -m pytest -q -m \"not db and not live\"",
    "format": "prettier --write frontend/src frontend/tests frontend/*.ts frontend/*.json *.json *.md *.yml"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
